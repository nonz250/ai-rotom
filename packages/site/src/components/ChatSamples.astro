---
/**
 * ai-rotom を使える AI に実際にこの質問を投げ、返ってきた答えを枠に収まる長さに要約したもの。
 * 数値は ai-rotom の計算結果なので、データを直したら答えを出し直す。
 */
interface Sample {
  question: string;
  lookups: string[];
  answer: Array<string | { num: string }>;
}

const samples: Sample[] = [
  {
    question: "カバルドンの対策を教えて",
    lookups: ["弱点と覚える技", "みず・くさ技で殴れる候補", "6 匹との対面"],
    answer: [
      "特防が ", { num: "94" }, " と防御の ", { num: "187" },
      " より低いので、特殊技で上から殴るのが確実です。雨のペリッパーのハイドロポンプは ", { num: "148.8〜175.8%" },
      " の確定 1 発で、素早さも ", { num: "85 対 67" }, " と先に動けます。あくびで流されないよう、有利な相手を出したら一気に削りましょう。",
    ],
  },
  {
    question: "ピカチュウでどうしても勝ちたい！",
    lookups: ["種族値と覚える技", "でんきだま込みのダメージ", "素早さのライン"],
    answer: [
      "でんきだま・ようき・H4 A32 S30 の物理型がおすすめです。素早さは ", { num: "154" }, " で止めれば準速 100 族の ", { num: "152" },
      " を抜けて、余りを HP に回せます。技はボルテッカー、はたきおとす、でんこうせっか、ねこだまし。でんきだまがないと、カイリューへのボルテッカーは ",
      { num: "64.1〜75.8%" }, " から ", { num: "32.3〜38.3%" }, " に落ちます。",
    ],
  },
  {
    question: "現環境でのガブリアスの評価を ai-rotom で計測して。",
    lookups: ["Web で使用率を検索", "上位 6 匹との対面", "素早さのライン"],
    answer: [
      "5 月時点のシングル使用率は 1 位で、計算でもブリジュラスやメガリザードンY に勝てます。最速なら ", { num: "169" }, " で最速メガリザードンY の ", { num: "167" },
      " を抜けるので、素早さは振り切りましょう。一方でマスカーニャのトリプルアクセルは ", { num: "142.7〜170.8%" },
      " でタスキを貫通し、アーマーガアは崩せません。この 2 匹を見る味方と組む前提です。",
    ],
  },
];
---

<div class="textbox" id="samples" aria-label="使い方の例">
  <div class="textbox-head">
    <span class="label">CHAT ─ 使い方の例</span>
    <div class="dots" role="group" aria-label="例を切り替える">
      {samples.map((_, i) => <button type="button" aria-label={`例 ${i + 1}`} aria-current={String(i === 0)}></button>)}
    </div>
  </div>
  <div class="slides" aria-live="off">
    {
      samples.map((sample, i) => (
        <div class="slide" data-active={String(i === 0)}>
          <div class="msg you">
            <span class="who">あなた</span>
            <p>{sample.question}</p>
          </div>
          <div class="msg">
            <span class="who">AI が ai-rotom で調べたこと</span>
            <div class="calls">{sample.lookups.map((lookup) => <span>{lookup}</span>)}</div>
          </div>
          <div class="msg">
            <span class="who">AI</span>
            <p>
              {sample.answer.map((part) => (typeof part === "string" ? part : <span class="num">{part.num}</span>))}
              <span class="cursor" aria-hidden="true" />
            </p>
          </div>
        </div>
      ))
    }
  </div>
  <span class="next" aria-hidden="true"></span>
  <p class="note">ai-rotom で実際に計算した結果です。ai-rotom が返すのはデータだけで、どう戦うかは AI があなたと一緒に考えます。</p>
</div>

<script>
  const ROTATE_INTERVAL_MS = 8000;
  const box = document.getElementById("samples");
  if (box) {
    const slides = Array.from(box.querySelectorAll<HTMLElement>(".slide"));
    const dots = Array.from(box.querySelectorAll<HTMLButtonElement>(".dots button"));
    let current = 0;
    let paused = false;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => (slide.dataset.active = String(i === current)));
      dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === current)));
    };
    const slidesRegion = box.querySelector<HTMLElement>(".slides");
    // 自動で切り替えるたびに読み上げると、ほかの場所を読んでいる人の邪魔になる。押して切り替えたときだけ読み上げる
    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        slidesRegion?.setAttribute("aria-live", "polite");
        show(i);
      }),
    );
    // タッチでは pointerleave が次に別の場所を触るまで来ないので、マウスのときだけ止める
    box.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") paused = true;
    });
    box.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") paused = false;
    });
    box.addEventListener("focusin", () => (paused = true));
    box.addEventListener("focusout", () => (paused = false));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) {
      setInterval(() => {
        if (!paused && !document.hidden) show(current + 1);
      }, ROTATE_INTERVAL_MS);
    }
  }
</script>

<style>
  /* ゲームのメッセージウィンドウ風の二重枠。テーマによらず同じ見た目にする */
  .textbox {
    position: relative;
    color: var(--box-ink);
    background:
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 4px),
      linear-gradient(180deg, rgba(24, 64, 80, 0.97), rgba(14, 42, 56, 0.97));
    border: 2px solid var(--box-line);
    border-radius: 4px;
    box-shadow: inset 0 0 0 5px rgba(14, 42, 56, 1), inset 0 0 0 6px rgba(127, 227, 196, 0.55), 0 14px 34px -16px rgba(0, 0, 0, 0.7);
    padding: 24px 24px 34px;
    display: grid;
    gap: 14px;
  }
  .textbox-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .label { font-family: var(--font-mono); font-size: 0.72rem; color: var(--box-dim); letter-spacing: 0.06em; }
  .dots { display: flex; gap: 6px; }
  .dots button { width: 22px; height: 6px; border-radius: 3px; border: 0; padding: 0; background: rgba(242, 251, 248, 0.2); cursor: pointer; }
  .dots button[aria-current="true"] { background: var(--box-line); }
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; display: grid; gap: 14px; align-content: start; transition: opacity 0.45s ease; }
  .slide[data-active="false"] { opacity: 0; visibility: hidden; }
  .msg { display: grid; gap: 4px; }
  .msg .who { font-family: var(--font-mono); font-size: 0.72rem; color: var(--box-dim); }
  .msg p { margin: 0; }
  .msg.you p { font-family: var(--font-display); font-size: 1.08rem; }
  .calls { display: flex; flex-wrap: wrap; gap: 6px; }
  .calls span { background: rgba(242, 251, 248, 0.07); border: 1px solid rgba(127, 227, 196, 0.45); border-radius: 4px; padding: 1px 8px; font-size: 0.75rem; }
  .num { font-family: var(--font-mono); color: var(--box-line); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .cursor { display: inline-block; width: 0.6em; height: 1em; background: var(--box-line); vertical-align: -0.12em; margin-left: 3px; animation: blink 1.1s steps(1) infinite; }
  .next { position: absolute; right: 18px; bottom: 12px; width: 10px; height: 10px; border-right: 2.5px solid var(--box-line); border-bottom: 2.5px solid var(--box-line); transform: rotate(45deg); animation: next 1.2s ease-in-out infinite; }
  .note { font-size: 0.75rem; color: var(--box-dim); margin: 0; }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes next { 50% { transform: translateY(3px) rotate(45deg); } }
  @media (prefers-reduced-motion: reduce) {
    .slide { transition: none; }
    .cursor, .next { animation: none; }
  }
</style>
