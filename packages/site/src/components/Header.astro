---
const GITHUB_URL = "https://github.com/nonz250/ai-rotom";
---

<header class="site-head">
  <div class="wrap">
    <a class="wordmark" href="#top">
      <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
        <path class="mark-body" d="M16 1 L19.5 12.7 A9 9 0 1 1 12.5 12.7 Z"></path>
        <ellipse class="mark-shine" cx="12.6" cy="17.6" rx="2.3" ry="1.5"></ellipse>
      </svg>
      ai-rotom
    </a>
    <nav class="site-nav" aria-label="ページ内">
      <a href="#start">はじめかた</a>
      <a href="#features">できること</a>
      <a href="#cli">CLI 版</a>
      <a href="#notes">注意事項</a>
      <a class="gh" href={GITHUB_URL}>
        <svg viewBox="0 0 16 16" aria-hidden="true"
          ><path
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path></svg
        >
        GitHub
      </a>
    </nav>
  </div>
</header>

<style>
  .site-head { background: var(--navy); border-bottom: 1px solid var(--navy-line); }
  .site-head .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; flex-wrap: wrap; }
  .wordmark { font-family: var(--font-display); font-size: var(--step-1); color: var(--navy-ink); text-decoration: none; letter-spacing: 0.02em; display: inline-flex; align-items: center; gap: 8px; }
  .mark { width: 30px; height: 30px; overflow: visible; }
  .mark-body { fill: var(--accent); stroke: var(--plasma); stroke-width: 1.3; stroke-linejoin: round; }
  .mark-shine { fill: #ffffff; opacity: 0.75; }
  .site-nav { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; font-size: var(--step--1); }
  .site-nav a { color: var(--navy-muted); text-decoration: none; }
  .site-nav a:hover { color: var(--navy-ink); }
  .site-nav .gh { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 3px 12px 3px 9px; background: var(--surface); }
  .site-nav .gh:hover { color: var(--ink); }
  .site-nav .gh svg { width: 16px; height: 16px; fill: currentColor; }
</style>
