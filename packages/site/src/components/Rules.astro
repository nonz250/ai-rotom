---
const specs = [
  { value: "0–32", body: "1 ステータスあたりの能力ポイント。1 ポイントで実数値が 1 上がります" },
  { value: "66", body: "能力ポイントの合計の上限" },
  { value: "31", body: "個体値は廃止され、全ポケモン一律" },
  { value: "Lv.50", body: "対戦のレベルは固定" },
];
---

<section class="block">
  <div class="wrap">
    <h2>チャンピオンズのルールで計算する</h2>
    <p class="intro">ポケモンチャンピオンズに特化！余計な入力は減らせます！</p>
    <div class="spec">
      {
        specs.map((spec) => (
          <div class="item">
            <div class="num">{spec.value}</div>
            <p>{spec.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .spec { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .item { border-left: 3px solid var(--accent); padding: 2px 0 2px 14px; min-width: 0; }
  .num { font-family: var(--font-mono); font-weight: 600; font-size: 1.5rem; font-variant-numeric: tabular-nums; line-height: 1.3; }
  p { margin: 4px 0 0; color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 820px) {
    .spec { grid-template-columns: repeat(2, 1fr); }
  }
</style>
