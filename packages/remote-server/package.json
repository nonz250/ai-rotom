{
  "name": "@ai-rotom/remote-server",
  "private": true,
  "type": "module",
  "description": "ai-rotom をリモート MCP サーバーとして動かすハンドラーと、サービスごとのエントリ。既定は Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "bundle": "node -e \"require('node:fs').rmSync('.wrangler/bundle',{recursive:true,force:true})\" && wrangler deploy --dry-run --outdir .wrangler/bundle",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.168.0"
  }
}
