{
  "name": "ai-rotom",
  "private": true,
  "workspaces": [
    "packages/mcp-server",
    "packages/remote-server",
    "packages/site"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "worker:dev": "npm run dev --workspace=@ai-rotom/remote-server"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
